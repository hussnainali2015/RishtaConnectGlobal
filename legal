function faq(c) {
  const items = kb(c), cats = [...new Set(items.map(i => i.cat))];
  const body = '<p>Quick answers about registering, your profile and using the site. Each answer is also given in Urdu. Our in-app assistant (the chat button) uses the same answers.</p>' +
    cats.map(cat => `<h2>${esc(cat)}</h2>` + items.filter(i => i.cat === cat).map(i =>
      `<details id="${esc(i.id)}" style="margin:8px 0;border:1px solid var(--ln);border-radius:12px;padding:10px 14px;background:var(--cd)"><summary style="cursor:pointer;font-weight:600">${esc(i.q.en)}</summary><p>${esc(i.a.en)}</p><p lang="ur" dir="rtl" style="font-family:'Noto Nastaliq Urdu','Jameel Noori Nastaleeq',serif;line-height:2.1"><b>${esc(i.q.ur)}</b><br>${esc(i.a.ur)}</p></details>`).join('')).join('') +
    `<h2>Still need help?</h2><p>${c.email ? `Write to ${mail(c)}.` : 'See our <a href="/contact">Contact page</a>.'}</p>`;
  return shell(c, 'Help and FAQ', body);
}

/* plain text of the answers (English), used by the AI assistant as its only source of facts */
const kbText = c => kb(c).map(i => `Q: ${i.q.en}\nA: ${i.a.en}`).join('\n\n');

