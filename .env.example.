NODE_ENV=production
PORT=3000
# Public https URL of this server. Moyasar must be able to reach it (webhook and return page).
BASE_URL=https://your-domain.com
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# Comma-separated Google emails allowed to use the admin API
ADMIN_EMAILS=you@gmail.com
# Moyasar dashboard > Settings > API keys.
# Start with the TEST pair (pk_test_ / sk_test_). Switch to the LIVE pair (pk_live_ / sk_live_) only after the checklist in the README.
# Both keys must be the same mode or the server refuses to start.
MOYASAR_PUBLISHABLE_KEY=
# SECRET: server only. Never put this in public/index.html, in git, in chat or in a screenshot.
MOYASAR_SECRET_KEY=
# A long random value you invent (openssl rand -hex 24). Enter the SAME value as the secret token when you create the webhook in the Moyasar dashboard.
MOYASAR_WEBHOOK_SECRET=
CURRENCY=SAR
# Set true to hold new profiles out of search until an admin approves them
REQUIRE_APPROVAL=false
# When REQUIRE_APPROVAL is true, a confirmed payment still approves the member automatically. Set false to keep manual approval.
AUTO_APPROVE_ON_PAYMENT=true

# Founder Membership: Premium Plus features at a lower price for the first N accounts that sign up
FOUNDER_PRICE=79
FOUNDER_LIMIT=100

# Sign in with Apple (optional; leave blank to hide the button). Needs an Apple Developer Program account.
# APPLE_CLIENT_ID is the Services ID, for example com.yourcompany.rishta.web
APPLE_CLIENT_ID=
# Must exactly match a Return URL registered on that Services ID, and be https
APPLE_REDIRECT_URI=https://your-domain.com/auth/apple/callback

# Scheduled backups (encrypted). Generate the key once with: openssl rand -hex 32
# KEEP THE KEY IN A SEPARATE SAFE PLACE. Without it the backups cannot be opened, and nobody can recover it.
BACKUP_ENABLED=false
BACKUP_KEY=
# Daily time in UTC (00:30 UTC is 03:30 in Riyadh)
BACKUP_AT=00:30
BACKUP_KEEP=14
BACKUP_DIR=./backups
# Optional second location, for example a mounted drive or sync folder, so one failed disk cannot take both
BACKUP_COPY_DIR=

# Shown on the Terms, Privacy and Contact pages
BUSINESS_NAME=Rishta Connect Global
SUPPORT_EMAIL=support@your-domain.com
# Set to true only after a lawyer in your country has reviewed the Terms and Privacy pages (legal.js). Until then they show a "draft" notice.
LEGAL_REVIEWED=false
# Optional: the law that governs the Terms, e.g. "the laws of the Kingdom of Saudi Arabia"
LEGAL_JURISDICTION=
